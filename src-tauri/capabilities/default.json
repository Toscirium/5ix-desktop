{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and detachable panel windows",
  "windows": ["main", "panel-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "opener:default",
    "updater:default",
    "process:default",
    "notification:default"
  ]
}
